                            intCersaiStatus = -3;
                        }
                        else if (strCersaiResRmrk.Contains("Father/Spouse name or Mother name details are mandatory"))
                        {
                            intCersaiStatus = -3;
                        }
                        else if (strCersaiResRmrk.Contains("70 Type Record should be provided"))
                        {
                            intCersaiStatus = -3;
                        }
                        else if (strCersaiResRmrk.Contains("Flag indicating Father or Spouse name is empty"))
                        {
                            intCersaiStatus = -3;
                        }
                        else
                        {
                            intCersaiStatus = 4;
                        }
                    }
                    else
                    {
                        intCersaiStatus = -3;
                    }
                    sb.Append(" UPDATE rd_application_dtls  SET  ");
                    sb.Append(" rad_cersai_ckyc_reference_no ='" + strCersaiCkycNo + "', rad_cersai_batch_response_dtls='" + strCersaiResRmrk + "', ");
                    sb.Append("rad_cersai_batch_status ='" + intCersaiStatus + "' ,rad_cersai_batch_remark='Response File Uploaded',");
                    sb.Append(" rad_cersai_batch_response_date=now(), rad_update_on=now(), rad_updated_by='" + HttpContext.Current.Session["UserId"].ToString() + "'");
                    //sb.Append(" WHERE rad_cersai_batch_id=" + lngBatchNumber + " and rad_signzy_ckyc_no= '" + strSignzyCkycNo + "'");
                    sb.Append(" WHERE rad_cersai_batch_id=" + lngBatchNumber + " and rad_cersai_reference_number= '" + strSignzyCkycNo + "'");
                    npgcom = new NpgsqlCommand(sb.ToString(), npgsqlConn);

                    strQry = sb.ToString();

                    intResult = npgcom.ExecuteNonQuery();
                    if (intResult == 0)
                    {
                        intAppStatus = 0;
                        Common.WriteErrorsToTextFile("dataAccess.cs", "dataAccess.UpdateResponseFile", "| Error occured while updating in apllication details", HttpContext.Current.Session["UserId"].ToString(), HttpContext.Current.Session["IP_Address"].ToString());
                    }
                    else
                    {
                        if (intCersaiStatus == 3)
                        {
                            sendCersaiCKYCNoToApplicants(strSignzyCkycNo, strCersaiCkycNo, strCersaiResRmrk, lngBatchNumber);
                        }
                    }
                }
            }
            if (intAppStatus == 1)
            {
                StringBuilder sb = new StringBuilder();
                sb.Append(" UPDATE rd_batch_mst  SET  ");
                sb.Append(" rbm_cersai_batch_status =3, rbm_cersai_batch_response_date=now(), rbm_cersai_batch_remark= 'Response file uploaded'");
                sb.Append(" WHERE rbm_cersai_batch_id=" + lngBatchNumber + " and rbm_cersai_batch_status =2 ");
                npgcom = new NpgsqlCommand(sb.ToString(), npgsqlConn);

                intResult = npgcom.ExecuteNonQuery();
                if (intResult == 0)
                {
                    Common.WriteErrorsToTextFile("dataAccess.cs", "dataAccess.UpdateResponseFile", "| Error occured while updating in batch details", HttpContext.Current.Session["UserId"].ToString(), HttpContext.Current.Session["IP_Address"].ToString());
                }
            }
        }

        catch (Exception ex)
        {
            Common.WriteErrorsToTextFile("dataAccess.cs", "dataAccess.updateSignzyDataInDB", ex.Message + " " + strCersaiCkycNo + " " + strQry, HttpContext.Current.Session["UserId"].ToString(), HttpContext.Current.Session["IP_Address"].ToString());
        }
        finally
        {
            if (npgsqlConn.State == ConnectionState.Open) npgsqlConn.Close();
        }
        return intResult;
    }

