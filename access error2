    public int updateSignzyDataInDB(RetailSignzyData.SignzyData objSignzyApplicantData)
    {
        int intResult = 0;
        try
        {

            npgsqlConn = new NpgsqlConnection(strCCILConnString);
            if (npgsqlConn.State == ConnectionState.Closed) npgsqlConn.Open();


            string strSignzyUpdatedResponse = objSignzyApplicantData.strSignzyResponse;
            if (strSignzyUpdatedResponse == null)
            {
                strSignzyUpdatedResponse = "{ }";
            }
            string strSignzyUpdatedRemark = objSignzyApplicantData.strRemark;

            if (strSignzyUpdatedRemark.Contains("'"))
            {
                strSignzyUpdatedRemark = strSignzyUpdatedRemark.Replace("'", "");
                if (strSignzyUpdatedRemark.Contains('"'))
                {
                    strSignzyUpdatedRemark = strSignzyUpdatedRemark.Replace('"', ' ');
                }
            }

            StringBuilder sb = new StringBuilder();
            sb.Append("CALL public.sp_updatesignzydata('" + objSignzyApplicantData.strSignzyFlag + "','" + objSignzyApplicantData.strApplicationtype + "','" + objSignzyApplicantData.strConstitutiontype + "',");
            sb.Append("'" + objSignzyApplicantData.strKycType + "','" + objSignzyApplicantData.strApplicantPrefix + "','" + objSignzyApplicantData.strApplicantName + "',");
            sb.Append("'" + Convert.ToDateTime(objSignzyApplicantData.strApplicantDOB) + "','" + objSignzyApplicantData.strApplicantPan + "','" + objSignzyApplicantData.strAddressChangeFlag + "' ,");
            sb.Append(" '" + objSignzyApplicantData.strSignzyRequest + "' , '" + strSignzyUpdatedResponse + "', '" + objSignzyApplicantData.strDocumentFlag + "',");
            sb.Append("'" + Convert.ToDateTime(objSignzyApplicantData.strFetchedDate) + "','" + strSignzyUpdatedRemark + "','" + HttpContext.Current.Session["UserId"].ToString() + "' ," + objSignzyApplicantData.strApplicationId + ")");
            npgcom = new NpgsqlCommand(sb.ToString(), npgsqlConn);

            intResult = npgcom.ExecuteNonQuery();
            if (intResult == 0)
            {

                Common.WriteErrorsToTextFile("dataAccess.cs", "dataAccess.updateSignzyDataInDB", objSignzyApplicantData.strApplicationId + "| Error occured while Insertion", HttpContext.Current.Session["UserId"].ToString(), HttpContext.Current.Session["IP_Address"].ToString());
            }

        }
