        {
            Common.WriteErrorsToTextFile("dataAccess.cs", "dataAccess.updateSignzyDataInDB", ex.Message, HttpContext.Current.Session["UserId"].ToString(), HttpContext.Current.Session["IP_Address"].ToString());
        }
        finally
        {
            if (npgsqlConn.State == ConnectionState.Open) npgsqlConn.Close();
        }
        return intResult;
    }

