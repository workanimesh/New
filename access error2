                {
                    intStatus = Convert.ToInt32(multiArray[3].ToString());
                    strSignzyCkycNo = multiArray[4].ToString();
                    strCersaiCkycNo = multiArray[5].ToString();
                    strCersaiResRmrk = multiArray[6].ToString().Replace("'", "");
                }
                if (intStatus > 0)
                {
                    if (intStatus == 01)
                    {
                        intCersaiStatus = 3;
                    }
