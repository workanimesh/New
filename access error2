    public static int UpdateResponseFile(string[] strLines, long lngBatchNumber)
    {
        int intResult = 0;
        string strCersaiCkycNo = null;
        string strQry = null;
        try
        {
            int intStatus = 0;
            int intCersaiStatus = 0;
            int intAppStatus = 1;
            string strSignzyCkycNo = null;
            //string strCersaiCkycNo = null;
            string strCersaiResRmrk = null;
            npgsqlConn = new NpgsqlConnection(strCCILConnString);
            if (npgsqlConn.State == ConnectionState.Closed) npgsqlConn.Open();

            foreach (string line in strLines)
            {
                StringBuilder sb = new StringBuilder();
                string[] multiArray = line.Split(new Char[] { '|' });
                //if ((Convert.ToInt32(multiArray[0].ToString())) == 10)
                //{
                //    lngBatchNumber = Convert.ToInt32(multiArray[1].ToString());
                //    //break;
                //}
                //else 
