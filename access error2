            npgcom = new NpgsqlCommand(sb.ToString(), npgsqlConn);
            npgcom.CommandType = CommandType.Text;
            npgreader = npgcom.ExecuteReader();

            if (npgreader.HasRows == true)
            {
                while (npgreader.Read())
                {
                    intAppIdCount = Convert.ToInt16(npgreader[0]);
                }
